{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "秒存",
  "version": "1.9.0",
  "identifier": "local.wangchangdian.videograbber",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "秒存",
        "width": 960,
        "height": 760,
        "minWidth": 720,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/**",
          "$DOWNLOAD/**",
          "$DESKTOP/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "nsis"
    ],
    "resources": {
      "../../engine": "engine",
      "../../VERSION": "engine/VERSION",
      "../../legal/THIRD-PARTY-NOTICES.txt": "THIRD-PARTY-NOTICES.txt",
      "../../scripts/bootstrap-engine.py": "scripts/bootstrap-engine.py",
      "../../runtime": "runtime"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
